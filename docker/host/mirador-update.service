[Unit]
Description=Update Mirador to the newest images
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mirador
ExecStart=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up --detach --remove-orphans
ExecStartPost=/usr/bin/docker image prune --force
