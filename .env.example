# Copy to .env for local development. Never commit .env.

# Port the API server listens on. The web dev server proxies /api to it.
PORT=3000

# PostgreSQL started by `pnpm db:up` (docker/compose.dev.yml). Development only.
DATABASE_URL=postgres://mirador:mirador@localhost:5432/mirador

# Lets anyone with the app's address create an account (SYS-13). Off unless set to true;
# the first account always needs the setup code the server prints in its log.
# MIRADOR_OPEN_SIGNUP=true
